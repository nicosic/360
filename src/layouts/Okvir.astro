---
interface Props {
  naslov: string;
}
const { naslov } = Astro.props;
const { sjednica, okruzenje, verzija, ispitna, korisnik } = Astro.locals;
const uloge = korisnik?.uloge ?? [];
const ima = (...trazene: string[]) => trazene.some((u) => uloge.includes(u));
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{naslov} · Ocjenjivanje</title>
  </head>
  <body>
    {
      ispitna && (
        <p class="poruka" role="note">
          Ispitna instanca. Ne unosite stvarne podatke: kod za prijavu se ne šalje e-poštom, nego se čita iz zapisa rada.
        </p>
      )
    }
    <header>
      <strong>Ocjenjivanje učinkovitosti rada</strong>
      {
        sjednica?.razina === 'potpuna' && (
          <form method="post" action="/odjava">
            <span>{sjednica.eposta}</span>
            <button type="submit">Odjava</button>
          </form>
        )
      }
    </header>
    {
      korisnik && (
        <nav aria-label="Glavni izbornik">
          <a href="/">Moji zadaci</a>
          {ima('kadrovska', 'odlucitelj') && <a href="/ciklus">Ciklusi</a>}
          {ima('kadrovska', 'administrator') && <a href="/organizacija">Organizacija</a>}
          {ima('kadrovska', 'administrator') && <a href="/postavke">Postavke</a>}
          {ima('administrator') && <a href="/revizija">Revizijski trag</a>}
        </nav>
      )
    }
    <main>
      <h1>{naslov}</h1>
      <slot />
    </main>
    <footer>Instanca: {okruzenje.instanca} · verzija {verzija}</footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }
  body {
    margin: 0 auto;
    max-width: 60rem;
    padding: 1rem;
  }
  header,
  header form {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  header {
    border-bottom: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    padding-bottom: 0.75rem;
  }
  nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.5rem 0;
  }
  textarea,
  select {
    font: inherit;
    padding: 0.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  select {
    max-width: 24rem;
  }
  fieldset {
    margin: 1rem 0;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  .greska {
    border-left-color: #b00020;
  }
  @media print {
    header,
    nav,
    footer,
    .bez-ispisa {
      display: none;
    }
    body {
      max-width: none;
    }
  }
  footer {
    margin-top: 3rem;
    font-size: 0.85rem;
    opacity: 0.7;
  }
  label {
    display: block;
    font-weight: 600;
    margin-top: 1rem;
  }
  input {
    font: inherit;
    padding: 0.5rem;
    width: 100%;
    max-width: 24rem;
    box-sizing: border-box;
  }
  button {
    font: inherit;
    padding: 0.5rem 1rem;
    margin-top: 1rem;
    cursor: pointer;
  }
  header button {
    margin-top: 0;
  }
  .poruka {
    border-left: 4px solid currentColor;
    padding: 0.5rem 0.75rem;
    margin: 1rem 0;
  }
  code {
    font-size: 1.05rem;
    word-break: break-all;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
</style>
